# ============================================================
# 环境配置说明（V3.5）
# ============================================================
# 微信小程序不支持传统 .env 文件，环境配置通过 config.ts 集中管理。
# 本文件仅作为可配置项参考文档，实际修改请编辑 config.ts。
#
# 配置优先级（运行时）：
#   1. wx.setStorageSync('md:dev_api_base', 'http://IP:PORT/api')  ← 最高
#   2. app.ts globalData.DEV_API_BASE
#   3. config.ts 默认值（localhost 兜底）                           ← 仅模拟器可用
# ============================================================

# ---- 开发环境 ----
# 后端端口（需与 uvicorn --port 保持一致）
DEV_PORT=8000

# 开发环境 API 地址（默认 localhost，真机调试需通过 Storage 配置真实 IP）
# DEV_API_URL=http://localhost:8000/api

# ---- 生产环境 ----
# 生产环境 BaseURL 通过加密方式注入，解密种子可配置：
#   wx.setStorageSync('md:encryption_seed', 'your-secret-seed')
# 或：
#   getApp().globalData.ENCRYPTION_SEED = 'your-secret-seed'

# ---- 运行时切换 IP（无需重新编译）----
# 在微信开发者工具 Console 中执行：
#   wx.setStorageSync('md:dev_api_base', 'http://你的本机IP:8000/api')
# 然后关闭小程序重新打开即可生效。