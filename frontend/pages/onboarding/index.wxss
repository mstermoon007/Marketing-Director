.onboard {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 32px;
  background: #0a0e1a;
}
.logo {
  font-size: 64px;
  margin-bottom: 16px;
}
.title {
  font-size: 24px;
  font-weight: 800;
  color: #eaf1ff;
}
.subtitle {
  font-size: 14px;
  color: #9fb0cc;
  text-align: center;
  margin-top: 10px;
  line-height: 1.6;
  max-width: 280px;
}
.login-btn {
  margin-top: 40px;
  background: #2f6bff;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  padding: 14px 40px;
  border-radius: 26px;
}
.login-btn.disabled {
  opacity: 0.6;
}
.tip {
  margin-top: 18px;
  font-size: 12px;
  color: #5f6c86;
}
