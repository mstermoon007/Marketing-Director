.page {
  min-height: 100vh;
  background: #0a0e1a;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty {
  margin-top: 200rpx;
  text-align: center;
  padding: 0 60rpx;
}
.empty-icon { font-size: 96rpx; }
.empty-title { font-size: 34rpx; color: #eaf0fb; font-weight: 600; margin-top: 24rpx; }
.empty-sub { font-size: 26rpx; color: #8b95a8; margin-top: 12rpx; line-height: 1.6; }

/* 综合健康度 hero */
.hero {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #111a2e, #0d1424);
  border: 1px solid #1c2740;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-score { display: flex; align-items: baseline; margin-right: 32rpx; }
.score-num { font-size: 88rpx; font-weight: 800; line-height: 1; }
.score-unit { font-size: 28rpx; margin-left: 6rpx; opacity: 0.8; }
.hero-meta { flex: 1; min-width: 0; }
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}
.hero-comment {
  font-size: 26rpx;
  color: #c3cee0;
  line-height: 1.6;
}
.hero-time { font-size: 22rpx; color: #6c7790; margin-top: 10rpx; }

/* 通用卡片 */
.card {
  background: #0d1424;
  border: 1px solid #1c2740;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  color: #eaf0fb;
  font-weight: 600;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 18rpx;
}
.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: #5b8def;
}

/* 雷达 */
.radar-wrap { display: flex; justify-content: center; padding: 12rpx 0; }
.dim-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-top: 12rpx;
}
.dim-item { font-size: 22rpx; color: #9fb0cc; background: #111a2e; padding: 6rpx 14rpx; border-radius: 999rpx; }

/* 问题 */
.issue { padding: 18rpx 0; border-top: 1px solid #18233c; }
.issue:first-of-type { border-top: none; }
.issue-head { display: flex; align-items: center; }
.issue-icon { font-size: 28rpx; margin-right: 10rpx; }
.issue-title { font-size: 27rpx; color: #eaf0fb; font-weight: 600; flex: 1; }
.issue-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1px solid;
}
.issue-cat { font-size: 22rpx; color: #6c7790; margin: 8rpx 0 0 38rpx; }
.issue-suggest { font-size: 24rpx; color: #9fb0cc; line-height: 1.6; margin: 8rpx 0 0 38rpx; }

/* 路线图 */
.roadmap-goal { font-size: 25rpx; color: #c3cee0; margin-bottom: 16rpx; line-height: 1.6; }
.phase { padding: 18rpx 0; border-top: 1px solid #18233c; }
.phase:first-of-type { border-top: none; }
.phase-head { display: flex; align-items: center; justify-content: space-between; }
.phase-name { font-size: 27rpx; color: #eaf0fb; font-weight: 600; }
.phase-week { font-size: 22rpx; color: #6c7790; }
.phase-actions { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 12rpx 0; }
.chip {
  font-size: 22rpx;
  color: #b9c6df;
  background: #111a2e;
  border: 1px solid #23304d;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.phase-criteria { font-size: 23rpx; color: #8b95a8; line-height: 1.5; }

/* 空状态主按钮 */
.btn-primary {
  background: #5b8def;
  color: #fff;
  font-size: 29rpx;
  border-radius: 999rpx;
  padding: 18rpx 56rpx;
  line-height: 1.4;
  margin-top: 32rpx;
}

/* 底部操作 */
.foot-bar { display: flex; gap: 20rpx; margin-top: 12rpx; }
.btn-ghost, .btn-share {
  flex: 1;
  font-size: 27rpx;
  border-radius: 999rpx;
  padding: 16rpx 0;
  line-height: 1.4;
}
.btn-ghost { background: #111a2e; color: #c3cee0; border: 1px solid #23304d; }
.btn-share { background: #5b8def; color: #fff; }
.foot-tip { text-align: center; font-size: 21rpx; color: #5a6580; margin-top: 16rpx; }
