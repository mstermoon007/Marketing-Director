.page {
  min-height: 100vh;
  background: #0a0e1a;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.empty { margin-top: 200rpx; text-align: center; padding: 0 60rpx; }
.empty-icon { font-size: 96rpx; }
.empty-title { font-size: 34rpx; color: #eaf0fb; font-weight: 600; margin-top: 24rpx; }
.empty-sub { font-size: 26rpx; color: #8b95a8; margin-top: 12rpx; line-height: 1.6; }

.head { padding: 8rpx 8rpx 20rpx; }
.head-title { font-size: 36rpx; color: #eaf0fb; font-weight: 700; }
.head-time { font-size: 22rpx; color: #6c7790; margin-top: 8rpx; }

.card {
  background: #0d1424;
  border: 1px solid #1c2740;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  color: #eaf0fb;
  font-weight: 600;
  margin-bottom: 18rpx;
  position: relative;
  padding-left: 18rpx;
}
.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: #5b8def;
}
.card-title.good::before { background: #07c160; }
.card-title.bad::before { background: #ff976a; }

.summary-text { font-size: 26rpx; color: #c3cee0; line-height: 1.7; }

/* 指标 */
.metric { padding: 16rpx 0; border-top: 1px solid #18233c; }
.metric:first-of-type { border-top: none; }
.metric-top { display: flex; justify-content: space-between; align-items: center; }
.metric-name { font-size: 26rpx; color: #eaf0fb; }
.metric-rate { font-size: 28rpx; font-weight: 700; }
.metric-bar { height: 12rpx; background: #18233c; border-radius: 999rpx; overflow: hidden; margin: 10rpx 0; }
.metric-fill { height: 100%; border-radius: 999rpx; }
.metric-num { font-size: 22rpx; color: #8b95a8; }

/* 优缺点 */
.line { font-size: 25rpx; color: #c3cee0; line-height: 1.7; padding: 8rpx 0; }
.line-empty { font-size: 24rpx; color: #6c7790; }

/* 建议 */
.sug { display: flex; align-items: flex-start; justify-content: space-between; padding: 14rpx 0; border-top: 1px solid #18233c; }
.sug:first-of-type { border-top: none; }
.sug-text { font-size: 25rpx; color: #c3cee0; line-height: 1.6; flex: 1; margin-right: 12rpx; }
.sug-rate { display: flex; gap: 8rpx; flex-shrink: 0; }
.sug-btn {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  background: #111a2e;
  border: 1px solid #23304d;
  border-radius: 999rpx;
}

/* 底部 */
.foot-bar { margin-top: 12rpx; }
.btn-primary {
  background: #5b8def;
  color: #fff;
  font-size: 29rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  line-height: 1.4;
}
.btn-done {
  background: #07c160;
  color: #fff;
  font-size: 29rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  line-height: 1.4;
}
.foot-tip { text-align: center; font-size: 21rpx; color: #5a6580; margin-top: 16rpx; }
