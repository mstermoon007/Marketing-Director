.pb {
  display: flex;
  align-items: center;
  gap: 10px;
}
.pb-label {
  font-size: 13px;
  color: #9fb0cc;
  flex: none;
  width: 84px;
}
.pb-track {
  flex: 1;
  height: 8px;
  background: #1a2540;
  border-radius: 6px;
  overflow: hidden;
}
.pb-fill {
  height: 100%;
  border-radius: 6px;
  transition: width 0.3s ease;
}
.pb-pct {
  font-size: 12px;
  color: #cfe0ff;
  flex: none;
  width: 38px;
  text-align: right;
}
