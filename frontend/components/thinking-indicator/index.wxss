.thinking {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.dots {
  display: flex;
  align-items: center;
  gap: 5px;
}
.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #3a4a6b;
}
.dot.on {
  background: #5b8def;
  animation: blink 1s infinite ease-in-out;
}
.dot.on:nth-child(2) {
  animation-delay: 0.2s;
}
.dot.on:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes blink {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.1); }
}
.steps {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.step {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #9fb0cc;
}
.tick {
  color: #07c160;
  font-weight: 700;
}
