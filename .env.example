# ───────────────────────────────────────────────────────────────
# AI 营销战略执行智能体 · 后端环境变量模板
# 复制为 .env 后填入真实值即可（所有变量均可选，未设置时取括号内默认值）
# 默认值来源：src/config/settings.py
# ───────────────────────────────────────────────────────────────

# ── 文本主模型（诊断 / 执行引擎 / 复盘报告）—— DeepSeek ──
LLM_TEXT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com

# ── 多模态模型（截图 / 图片数据解析）—— OpenAI GPT-4o ──
LLM_VISION_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1

# ── 向量化（ChromaDB 记忆 & 知识库）—— 本地哈希(默认,离线) 或 OpenAI ──
# 设为 openai 时启用 text-embedding-3-small（需 OPENAI_API_KEY），否则用本地哈希向量
AGENT_EMBEDDING_PROVIDER=local

# ── 通用 LLM 参数 ──
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ── 运行环境（development / staging / production）──
# 生产部署必须显式设置 APP_ENV=production（CloudRun 镜像已在 Dockerfile 默认置为 production）。
# staging 为独立预发环境，落到 data/app_staging.db，不与开发/生产混用。
# 未设置 DATABASE_URL 时，数据库按环境隔离到不同物理文件：
#   production -> data/app_prod.db，staging -> data/app_staging.db，development -> data/app_dev.db
# ⚠️ 数据隔离护栏：若以生产服务形态运行（CloudRun 注入 PORT）却解析到 data/app_dev.db，
#   后端会在启动时拒绝启动（RuntimeError: PROD_ENV_MISCONFIG）。详见 scripts/check_prod_env.py。
APP_ENV=development

# ── 数据库（已为异步驱动 sqlite+aiosqlite）──
# 留空则按 APP_ENV 自动选择 data/app_dev.db 或 data/app_prod.db；
# 部署生产时建议显式指定独立库（如 PostgreSQL / 独立 sqlite 文件）以彻底隔离。
# 注意：不要在此填 data/app.db（旧默认值），生产请指向 app_prod.db 或托管库。
DATABASE_URL=

# ── 服务运行端口（uvicorn 监听端口；CloudRun 容器模式由平台注入 PORT，本地默认 8000）──
# 仅本地开发填写；CloudRun 会自动注入 PORT，本地留空即默认 8000。
PORT=

# ── 鉴权（JWT，必须设置，禁止留空）──
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ── 微信小程序（留空则后端登录走开发 mock 模式）──
WECHAT_APPID=
WECHAT_SECRET=

# ── 生产环境后端公开基址（登录成功后下发给小程序，避免前端硬编码/加密敏感配置）──
# 留空则完全依赖登录返回；部署时建议填入公开生产域名（如 https://api.example.com/api）
PUBLIC_API_BASE_URL=

# ── CORS 白名单（逗号分隔域名，留空使用默认本地开发域名）──
CORS_ALLOWED_ORIGINS=

# ── 文件上传限制 ──
# 最大上传文件大小（MB），默认 20
MAX_UPLOAD_SIZE_MB=20

# ── ChromaDB 持久化目录（默认 data/chroma_db）──
CHROMA_PERSIST_DIR=data/chroma_db

# ── 营销知识库卡片文件路径（JSONL）──
MARKETING_KNOWLEDGE_FILE=data/marketing_knowledge_cards.jsonl

# ── RAG 检索参数 ──
# 知识库每次检索返回条数，默认 5
AGENT_KNOWLEDGE_TOP_K=5
# 多轮对话历史保留条数，默认 12
AGENT_HISTORY_WINDOW=12
# 是否强制重建知识库（首次启动或卡片更新后建议设为 true 一次）
AGENT_REBUILD_KNOWLEDGE=false
# 意图分类是否使用 LLM（无 Key 时走规则匹配），默认 true
AGENT_USE_LLM_INTENT=true

# ── 调试 / 日志 ──
DEBUG=false
