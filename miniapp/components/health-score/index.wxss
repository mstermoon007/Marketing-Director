.health-score-container {
  padding: var(--spacing-xl) var(--spacing-lg);
  background: #fff;
  border-radius: var(--radius-lg);
}

.score-ring-wrap {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-ring {
  width: 100%;
  height: 100%;
}

.ring-bg {
  stroke-width: 16;
}

.ring-progress {
  stroke-width: 16;
  transition: stroke-dashoffset 0.8s ease, stroke 0.3s ease;
}

.score-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.score-number {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-left: 8rpx;
}

.overall-comment {
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  padding: 0 var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.dimensions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.dim-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dim-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dim-name {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
}

.dim-score {
  font-size: 26rpx;
  font-weight: 600;
}

.dim-track {
  height: 16rpx;
  background: var(--color-border-light);
  border-radius: 8rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease, background 0.3s ease;
}
