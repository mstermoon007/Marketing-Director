.progress-bar-container {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.phase-label {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.phase-tag {
  background: var(--color-primary);
  color: #fff;
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.phase-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.week-info {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.progress-track {
  position: relative;
  height: 20rpx;
  background: var(--color-border-light);
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-success));
  border-radius: 10rpx;
  transition: width 0.6s ease;
}

.phase-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #fff;
  z-index: 1;
}

.phase-markers {
  display: flex;
  justify-content: space-between;
}

.phase-marker-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}
