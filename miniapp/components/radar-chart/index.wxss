.radar-chart {
  min-height: 560rpx;
  padding: var(--spacing-lg);
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-svg-wrap {
  width: 100%;
  max-width: 520rpx;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  box-sizing: border-box;
}

.radar-svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}

.grid-polygon {
  stroke: var(--color-border);
  fill: none;
}

.axis-line {
  stroke: var(--color-border);
}

.score-polygon {
  fill: var(--color-primary);
  fill-opacity: 0.3;
  stroke: var(--color-primary);
  stroke-width: 2;
  transition: all 0.3s ease;
}

.data-point {
  fill: var(--color-primary);
  stroke: var(--color-white);
  stroke-width: 1;
}

.dimension-label {
  font-weight: 600;
  fill: var(--color-text);
}

.radar-legend {
  width: 100%;
  margin-top: var(--spacing-lg);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding: 0 var(--spacing-sm);
  box-sizing: border-box;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.legend-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-xs);
  flex-shrink: 0;
}

.legend-info {
  display: flex;
  align-items: baseline;
  gap: var(--spacing-xs);
  width: 160rpx;
  flex-shrink: 0;
}

.legend-name {
  font-size: var(--font-size-sm);
  color: var(--color-text);
  font-weight: 500;
}

.legend-score {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-weight: 600;
}

.legend-bar {
  flex: 1;
  height: 12rpx;
  background: var(--color-border-light);
  border-radius: var(--radius-round);
  overflow: hidden;
  min-width: 120rpx;
}

.legend-bar-fill {
  height: 100%;
  border-radius: var(--radius-round);
  transition: width 0.4s ease;
}
