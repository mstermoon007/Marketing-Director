.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.text {
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

.btn-action {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  width: auto;
}
