.phase-timeline {
  position: relative;
  padding: var(--spacing-md) 0 var(--spacing-md) var(--spacing-lg);
}

.timeline-line {
  position: absolute;
  left: 44rpx;
  top: 40rpx;
  bottom: 40rpx;
  width: 4rpx;
  background: var(--color-border);
}

.phase-item {
  position: relative;
  margin-bottom: var(--spacing-xl);
}

.phase-item:last-child {
  margin-bottom: 0;
}

.timeline-dot-wrap {
  position: absolute;
  left: -8rpx;
  top: 40rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.timeline-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--color-white);
  border: 4rpx solid var(--color-border);
  box-sizing: border-box;
}

.timeline-dot.dot-completed {
  background: var(--color-success);
  border-color: var(--color-success);
}

.timeline-dot.dot-current {
  background: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 8rpx rgba(25, 137, 250, 0.15);
}

.timeline-dot.dot-pending {
  background: var(--color-white);
  border-color: var(--color-border);
}

.phase-card {
  margin-left: 64rpx;
  background: var(--color-white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: var(--spacing-lg);
  position: relative;
  overflow: hidden;
}

.phase-card.card-current {
  border-left: 6rpx solid var(--color-primary);
  padding-left: calc(var(--spacing-lg) - 6rpx);
}

.phase-card.card-completed {
  opacity: 0.85;
}

.phase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 2rpx solid var(--color-border-light);
}

.phase-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.phase-name {
  font-size: var(--font-size-lg);
  font-weight: 700;
  color: var(--color-text);
}

.phase-weeks {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.phase-badge {
  padding: 6rpx 20rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-size-xs);
  font-weight: 600;
  background: var(--color-primary);
  color: var(--color-white);
}

.phase-badge.badge-done {
  background: rgba(7, 193, 96, 0.1);
  color: var(--color-success);
}

.phase-badge.badge-pending {
  background: var(--color-border);
  color: var(--color-text-secondary);
}

.phase-section {
  margin-top: var(--spacing-md);
}

.section-label {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-sm);
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.action-item {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.action-icon {
  font-size: var(--font-size-md);
  flex-shrink: 0;
  line-height: 1.6;
}

.action-text {
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.6;
  flex: 1;
}

.success-criteria {
  font-size: var(--font-size-md);
  color: var(--color-text);
  line-height: 1.7;
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-background-light);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid var(--color-warning);
}
