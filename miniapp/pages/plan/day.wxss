/* 日详情页 */
.page { min-height: 100vh; }

.day-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 48rpx 36rpx;
  color: #fff;
}

.day-label {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.day-focus {
  font-size: 28rpx;
  opacity: 0.8;
}

/* 时间线 */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 20rpx;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 12rpx;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 86rpx;
  top: 36rpx;
  bottom: 0;
  width: 2rpx;
  background: #e0e0e0;
}

.timeline-time {
  width: 100rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  border: 4rpx solid #e0e0e0;
  margin: 8rpx 20rpx 0 0;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-dot.done {
  background: #4caf50;
  border-color: #c8e6c9;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.task-done {
  color: #999;
  text-decoration: line-through;
}

.task-how {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.checklist {
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.check-item {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 6rpx;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 22rpx;
  color: #999;
}

.done-criteria {
  color: #4caf50;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}
