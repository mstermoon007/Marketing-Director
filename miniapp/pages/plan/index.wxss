/* 7天任务卡片页 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 主题横幅 */
.theme-banner {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 48rpx 36rpx;
  color: #fff;
}

.theme-label {
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
}

.theme-title {
  font-size: 38rpx;
  font-weight: 700;
}

/* 目标列表 */
.goals-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goal-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.goal-marker {
  flex-shrink: 0;
  margin-top: 2rpx;
}

/* 指标行 */
.metrics-row {
  display: flex;
  margin: 0 24rpx;
  gap: 16rpx;
}

.metric-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.metric-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 7天卡片横滑 */
.days-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx;
}

.day-card {
  display: inline-block;
  width: 180rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  margin-right: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
  vertical-align: top;
}

.day-card.active {
  background: #1a1a2e;
  color: #fff;
  transform: scale(1.05);
}

.day-card.active .day-focus,
.day-card.active .day-task-count {
  color: rgba(255,255,255,0.7);
}

.day-label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.day-focus {
  font-size: 22rpx;
  color: #666;
  white-space: normal;
  line-height: 1.4;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.day-task-count {
  font-size: 22rpx;
  color: #999;
}

/* 日详情 */
.day-focus-area {
  margin-bottom: 24rpx;
}

.focus-tag {
  display: inline-block;
  background: #e8f5e9;
  color: #2e7d32;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.task-item {
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-time {
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 600;
}

.task-check {
  font-size: 36rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.task-how {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.checklist {
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.check-item {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 6rpx;
  line-height: 1.5;
}

.check-bullet {
  color: #1a1a2e;
  margin-right: 8rpx;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-done-criteria {
  font-size: 22rpx;
  color: #4caf50;
}

.criteria-icon {
  margin-right: 6rpx;
}

.task-duration {
  font-size: 22rpx;
  color: #999;
}

/* action */
.action-area {
  padding: 40rpx 36rpx;
}

.day-detail-link {
  margin-top: 24rpx;
  padding: 20rpx;
  text-align: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}

.action-inline {
  margin-top: 16rpx;
  padding: 20rpx;
  text-align: center;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* loading */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a1a2e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
