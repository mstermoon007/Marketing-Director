<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:if="{{!loading && task}}" class="content">
    <view class="header-card">
      <view class="header-row">
        <view class="task-title">
          <text class="title-icon">📋</text>
          <text class="title-text">{{task.title}}</text>
        </view>
        <view class="status-tag {{statusClass}}">{{statusLabel}}</view>
      </view>
      <view class="header-meta">
        <view class="meta-item">
          <text class="meta-icon">🕒</text>
          <text class="meta-text">{{timeSlot}}</text>
        </view>
        <view class="meta-item" wx:if="{{estimatedMinutes > 0}}">
          <text class="meta-icon">⏱</text>
          <text class="meta-text">约{{estimatedMinutes}}分钟</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text class="section-icon">💡</text>
        <text class="section-text">怎么做</text>
      </view>
      <view class="how-to-card">
        <text class="how-to-text">{{task.how_to}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{task.checklist && task.checklist.length > 0}}">
      <view class="section-title">
        <text class="section-icon">📝</text>
        <text class="section-text">执行步骤</text>
      </view>
      <view class="checklist-card">
        <view
          class="checklist-item {{checklistStates[index] ? 'checked' : ''}}"
          wx:for="{{task.checklist}}"
          wx:key="*this"
          data-idx="{{index}}"
          bindtap="onToggleChecklist"
        >
          <view class="check-box">
            <text wx:if="{{checklistStates[index]}}">✓</text>
          </view>
          <view class="check-index">{{index + 1}}</view>
          <text class="check-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{task.done_criteria}}" class="section">
      <view class="section-title">
        <text class="section-icon">🎯</text>
        <text class="section-text">完成标准</text>
      </view>
      <view class="done-criteria-card">
        <text class="done-criteria-text">{{task.done_criteria}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text class="section-icon">📸</text>
        <text class="section-text">执行记录</text>
      </view>

      <view class="record-card">
        <view wx:if="{{images.length > 0}}" class="images-grid">
          <view
            class="image-item"
            wx:for="{{images}}"
            wx:key="id"
            data-idx="{{index}}"
            bindtap="onPreviewImage"
          >
            <image class="image-preview" src="{{item.url}}" mode="aspectFill"></image>
            <view
              wx:if="{{!isDone}}"
              class="image-remove"
              catchtap="onRemoveImage"
              data-idx="{{index}}"
            >×</view>
          </view>
        </view>

        <view wx:if="{{textNotes.length > 0}}" class="notes-list">
          <view class="note-item" wx:for="{{textNotes}}" wx:key="id">
            <text class="note-content">{{item.content}}</text>
          </view>
        </view>

        <view class="record-actions">
          <view class="action-btn action-btn-camera" bindtap="onAddImage">
            <text class="action-icon">📸</text>
            <text class="action-text">拍照记录</text>
          </view>
          <view class="action-btn action-btn-text" bindtap="onAddTextNote">
            <text class="action-icon">📝</text>
            <text class="action-text">文字记录</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-placeholder"></view>
  </view>

  <view wx:if="{{!loading && task && !isDone}}" class="bottom-bar">
    <view class="done-btn" bindtap="onMarkDone">
      <text class="btn-icon">✅</text>
      <text class="btn-text">标记完成</text>
    </view>
  </view>

  <view wx:if="{{!loading && task && isDone}}" class="bottom-bar bottom-bar-done">
    <view class="done-tag">
      <text class="done-tag-icon">✅</text>
      <text class="done-tag-text">已完成打卡</text>
    </view>
  </view>
</view>
