<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:if="{{!loading && plan}}" class="content">
    <view class="progress-header">
      <view class="progress-header-row">
        <view class="week-label">{{weekLabel}} · 完成率{{completionRate}}%</view>
        <view class="progress-count">{{doneCount}}/{{totalCount}}</view>
      </view>
      <view class="progress-bar-outer">
        <view class="progress-bar-inner" style="width: {{completionRate}}%"></view>
      </view>
    </view>

    <week-calendar
      startDate="{{plan.start_date}}"
      activeDayIndex="{{activeDay}}"
      dailyCompletion="{{dailyCompletion}}"
      bind:change="onDayTap"
    />

    <view wx:if="{{activeDayData}}" class="day-section">
      <view class="day-focus-card">
        <view class="day-focus-title">{{activeDayData.day_name}} · 核心营销动作</view>
        <view class="day-focus-text">{{activeDayData.focus}}</view>
      </view>

      <block wx:if="{{activeDayData.tasks && activeDayData.tasks.length > 0}}">
        <view class="task-list">
          <task-card
            wx:for="{{activeDayData.tasks}}"
            wx:key="id"
            task="{{item}}"
            showCheckin="{{true}}"
            data-task-id="{{item.id}}"
            bind:detail="onTaskDetail"
            bind:checkin="onTaskCheckIn"
          />
        </view>
      </block>

      <empty-state
        wx:else
        icon="💤"
        text="休息日，老板辛苦了"
      />
    </view>

    <view class="bottom-placeholder"></view>
  </view>

  <empty-state
    wx:if="{{!loading && !plan}}"
    icon="📅"
    text="尚未生成本周任务"
    action-text="重新加载"
    bind:action="onRetry"
  />

  <view wx:if="{{!loading && plan}}" class="bottom-bar">
    <view class="review-btn" bindtap="onStartReview">
      <text class="btn-icon">📋</text>
      <text class="btn-text">本周复盘</text>
    </view>
  </view>
</view>
