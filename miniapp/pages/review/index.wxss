.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 200rpx;
}

.content {
  padding: 24rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-tag {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #fff;
  border: 2rpx solid #e5e6eb;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #4e5969;
  transition: all 0.2s;
}

.type-tag.active {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-color: #1677ff;
  color: #fff;
  font-weight: 600;
}

.week-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.question-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.question-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.question-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.question-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  flex: 1;
}

.question-tip {
  font-size: 22rpx;
  color: #faad14;
  background: #fffbe6;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}

.question-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.7;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #a0a6b1;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.image-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  background: #f7f8fa;
  border: 2rpx dashed #c9cdd4;
  border-radius: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #86909c;
}

.ai-card {
  background: linear-gradient(160deg, #eef4ff 0%, #fff7e6 60%, #f6ffed 100%);
}

.ai-header {
  margin-bottom: 24rpx;
}

.refresh-btn {
  font-size: 24rpx;
  color: #1677ff;
  padding: 6rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.ai-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 5rpx solid #e5e6eb;
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: aiSpin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes aiSpin {
  to { transform: rotate(360deg); }
}

.ai-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  animation: bounce 1.2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.ai-loading-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1677ff;
  margin-bottom: 8rpx;
}

.ai-sub-text {
  font-size: 24rpx;
  color: #86909c;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e8f3ff;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 12rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #4e5969;
  line-height: 1.8;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.worked-label {
  color: #07c160;
}

.didnt-label {
  color: #ee0a24;
}

.suggestions-label {
  color: #1677ff;
}

.metrics-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.metric-item {
  margin-bottom: 20rpx;
}

.metric-item:last-child {
  margin-bottom: 0;
}

.metric-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.metric-name {
  font-size: 26rpx;
  color: #4e5969;
}

.metric-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2129;
}

.metric-bar-outer {
  height: 14rpx;
  background: #f2f3f5;
  border-radius: 7rpx;
  overflow: hidden;
}

.metric-bar-inner {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.5s ease;
}

.metric-bar-inner.achieved {
  background: linear-gradient(90deg, #07c160 0%, #00b42a 100%);
}

.metric-bar-inner.not-achieved {
  background: linear-gradient(90deg, #faad14 0%, #ff7a00 100%);
}

.worked-section,
.didnt-section,
.suggestions-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.worked-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.worked-bullet {
  color: #07c160;
  font-weight: 700;
  margin-right: 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.worked-text {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}

.didnt-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.didnt-bullet {
  color: #ee0a24;
  font-weight: 700;
  margin-right: 12rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}

.didnt-text {
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.6;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.suggestion-index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.suggestion-text {
  font-size: 26rpx;
  color: #1d2129;
  line-height: 1.7;
  flex: 1;
}

.bottom-placeholder {
  height: 60rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(135deg, #722ed1 0%, #1677ff 100%);
  border-radius: 48rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(114, 46, 209, 0.3);
}

.submit-btn.disabled {
  opacity: 0.75;
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-content {
  display: flex;
  align-items: center;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
}

.submit-arrow {
  font-size: 36rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.submit-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
}

.submit-progress-outer {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.submit-progress-inner {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.2s ease;
}

.submit-loading-text {
  font-size: 26rpx;
  opacity: 0.95;
}
