<!-- 截图上传页 -->
<view class="page">
  <view class="header">
    <view class="title">上传数据截图</view>
    <view class="subtitle">把本周各平台后台截图、导出的CSV或销售报表上传，AI会自动识别数据并生成复盘报告</view>
  </view>

  <card title="支持上传">
    <view class="support-list">
      <view class="support-item">
        <text class="support-icon">📸</text>
        <view class="support-text">
          <view class="support-name">平台后台截图</view>
          <view class="support-desc">抖音/小红书/微信后台数据截图</view>
        </view>
      </view>
      <view class="support-item">
        <text class="support-icon">📊</text>
        <view class="support-text">
          <view class="support-name">CSV数据文件</view>
          <view class="support-desc">从平台导出的数据报表</view>
        </view>
      </view>
      <view class="support-item">
        <text class="support-icon">📋</text>
        <view class="support-text">
          <view class="support-name">销售记录截图</view>
          <view class="support-desc">微信聊天记录、Excel表格截图等</view>
        </view>
      </view>
      <view class="support-item">
        <text class="support-icon">🔢</text>
        <view class="support-text">
          <view class="support-name">直接填写数据</view>
          <view class="support-desc">直接输入本周关键数据</view>
        </view>
      </view>
      <view class="support-item">
        <text class="support-icon">📝</text>
        <view class="support-text">
          <view class="support-name">文字总结</view>
          <view class="support-desc">简要描述本周做了什么、效果如何</view>
        </view>
      </view>
    </view>
  </card>

  <!-- 已选文件预览 -->
  <card wx:if="{{files.length > 0}}" title="已选文件">
    <view class="file-grid">
      <view class="file-item" wx:for="{{files}}" wx:key="*this">
        <image class="file-preview" src="{{item}}" mode="aspectFill" wx:if="{{item}}" bindtap="onPreviewImage" data-src="{{item}}"></image>
        <view class="file-remove" data-index="{{index}}" bindtap="onRemoveFile">×</view>
      </view>
    </view>
  </card>

  <!-- 上传按钮 -->
  <view class="actions">
    <button class="btn-secondary" bindtap="onChooseImage">
      📸 选择截图
    </button>
    <button class="btn-secondary" bindtap="onChooseMessageFile">
      📊 选择CSV
    </button>
  </view>

  <view class="submit-area">
    <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{files.length === 0}}">
      {{submitting ? 'AI分析中...' : '生成复盘报告'}}
    </button>
  </view>
</view>
