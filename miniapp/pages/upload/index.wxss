/* 截图上传页 */
.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #fff;
  padding: 48rpx 36rpx 56rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.8;
  line-height: 1.5;
}

.support-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.support-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.support-icon {
  font-size: 48rpx;
  width: 80rpx;
  text-align: center;
}

.support-text {
  flex: 1;
}

.support-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.support-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.file-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.file-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.file-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.file-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.actions {
  display: flex;
  gap: 20rpx;
  padding: 0 36rpx;
  margin-top: 24rpx;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  color: #1a1a2e;
  border: 2rpx solid #1a1a2e;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.submit-area {
  padding: 40rpx 36rpx;
}
