.profile-container {
  min-height: 100vh;
  background: var(--color-background);
  padding-bottom: 60rpx;
}

.top-banner {
  position: relative;
  padding: 48rpx 32rpx 64rpx;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
}

.banner-content {
  position: relative;
  z-index: 1;
}

.company-row {
  margin-bottom: 20rpx;
}

.company-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.banner-tag {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border-radius: var(--radius-round);
  font-size: 24rpx;
  backdrop-filter: blur(10px);
}

.phase-tag {
  background: rgba(25, 137, 250, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.week-info {
  padding-top: 4rpx;
}

.week-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.stats-grid {
  display: flex;
  margin: -32rpx 24rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 32rpx 0;
  position: relative;
  z-index: 2;
}

.stats-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid var(--color-border-light);
}

.stats-cell:last-child {
  border-right: none;
}

.stats-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.section-card {
  background: #fff;
  margin: 24rpx;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--color-border-light);
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.title-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-round);
  background: var(--color-background);
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 24rpx;
  color: var(--color-primary);
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-border-light);
  align-items: flex-start;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.6;
  word-break: break-all;
}

.channel-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.form-input {
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-textarea {
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  line-height: 1.6;
}

.form-picker {
  background: var(--color-background);
  border-radius: var(--radius-md);
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker.placeholder {
  color: var(--color-text-placeholder);
}

.arrow {
  color: #c8c9cc;
  font-size: 32rpx;
  transform: rotate(90deg);
}

.save-btn {
  margin-top: 40rpx;
}

.shortcuts-card {
  padding-bottom: 20rpx;
}

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 12rpx;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0;
}

.shortcut-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-background);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.shortcut-text {
  font-size: 24rpx;
  color: var(--color-text);
}

.action-area {
  margin: 40rpx 48rpx 0;
}

.reset-btn {
  background: #fff;
  border: 2rpx solid #ffd0d6;
  border-radius: var(--radius-md);
  padding: 28rpx;
  text-align: center;
}

.reset-text {
  color: var(--color-danger);
  font-size: 28rpx;
  font-weight: 500;
}
