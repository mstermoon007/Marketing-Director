<!-- 工作台首页 -->
<view class="page">
  <!-- loading -->
  <loading wx:if="{{loading}}" text="加载中..."></loading>

  <block wx:else>
    <!-- 已完成全流程：展示进度和快捷入口 -->
    <block wx:if="{{plan}}">
      <!-- 欢迎横幅 -->
      <view class="welcome-banner">
        <view class="welcome-title">👋 {{business.business_name || '老板'}}</view>
        <view class="welcome-subtitle">{{plan.theme}}</view>
        <view class="welcome-date">本周目标已设定</view>
      </view>

      <!-- 进度步骤 -->
      <view class="step-flow">
        <view class="step {{diagnosis ? 'done' : ''}}">
          <view class="step-icon">✓</view>
          <view class="step-label">诊断完成</view>
        </view>
        <view class="step-line"></view>
        <view class="step {{plan ? 'done' : ''}}">
          <view class="step-icon">✓</view>
          <view class="step-label">计划生成</view>
        </view>
        <view class="step-line"></view>
        <view class="step {{review ? 'done' : 'active'}}">
          <view class="step-icon">{{review ? '✓' : '→'}}</view>
          <view class="step-label">{{review ? '已复盘' : '待复盘'}}</view>
        </view>
      </view>

      <!-- 本周目标 -->
      <card title="本周目标">
        <view class="goal-list">
          <view class="goal-item" wx:for="{{plan.goals}}" wx:key="*this">
            <text class="goal-marker">🎯</text>
            <text>{{item}}</text>
          </view>
        </view>
      </card>

      <!-- 数据指标 -->
      <view class="metrics-row" wx:if="{{plan.key_metrics}}">
        <view class="metric-box" wx:for="{{plan.key_metrics}}" wx:key="*this">
          <view class="metric-value">0</view>
          <view class="metric-label">{{index}}</view>
        </view>
      </view>

      <!-- 快捷操作 -->
      <card title="快捷操作" padding="32rpx">
        <view class="action-grid">
          <view class="action-item" bindtap="goPlan">
            <view class="action-icon">📅</view>
            <view class="action-text">查看执行计划</view>
          </view>
          <view class="action-item" bindtap="goUpload">
            <view class="action-icon">📸</view>
            <view class="action-text">上传截图复盘</view>
          </view>
          <view class="action-item" bindtap="goDiagnosis" wx:if="{{diagnosis}}">
            <view class="action-icon">📋</view>
            <view class="action-text">查看诊断报告</view>
          </view>
          <view class="action-item" bindtap="goReview" wx:if="{{review}}">
            <view class="action-icon">📊</view>
            <view class="action-text">查看复盘报告</view>
          </view>
        </view>
      </card>

      <!-- 底部：重新开始 -->
      <view class="bottom-area">
        <text class="reset-link" bindtap="onReset">重新开始</text>
      </view>
    </block>

    <!-- 仅完成诊断：引导生成计划 -->
    <block wx:elif="{{diagnosis}}">
      <view class="welcome-banner">
        <view class="welcome-title">💡 诊断已完成</view>
        <view class="welcome-subtitle">{{diagnosis.strategy_summary}}</view>
        <view class="welcome-date">下一步：生成7天执行清单</view>
      </view>

      <card title="诊断摘要">
        <view class="diag-score">
          <view class="score-num">{{diagnosis.overall_score}}</view>
          <view class="score-label">营销健康度</view>
        </view>
        <view class="diag-strategy">{{diagnosis.this_week_focus}}</view>
      </card>

      <view class="action-area">
        <button class="btn-primary" bindtap="goPlan">生成7天执行清单</button>
      </view>
    </block>

    <!-- 仅填写了企业信息：引导诊断 -->
    <block wx:elif="{{business}}">
      <view class="welcome-banner">
        <view class="welcome-title">📝 信息已收到</view>
        <view class="welcome-subtitle">AI即将开始分析你的企业</view>
        <view class="welcome-date">下一步：生成诊断报告</view>
      </view>

      <view class="action-area">
        <button class="btn-primary" bindtap="goDiagnosis">开始AI诊断</button>
      </view>
    </block>

    <!-- 全新用户：引导填写信息 -->
    <block wx:else>
      <view class="welcome-banner">
        <view class="welcome-title">👋 欢迎使用营销军师</view>
        <view class="welcome-subtitle">把营销想成可执行的每日任务</view>
        <view class="welcome-date">三步搞定：填信息 → AI诊断 → 7天执行清单</view>
      </view>

      <!-- 行业技能预览 -->
      <card title="行业洞察" wx:if="{{skillTips.length > 0}}">
        <view class="skill-header">
          <text class="skill-icon">{{skillIcon}}</text>
          <text class="skill-label">{{skillLabel}}行业专属建议</text>
        </view>
        <view class="skill-tips">
          <view class="skill-tip" wx:for="{{skillTips}}" wx:key="*this">
            <text class="tip-bullet">→</text>
            <text class="tip-text">{{item}}</text>
          </view>
        </view>
        <view class="skill-hint">AI将根据你的行业提供针对性诊断</view>
      </card>

      <view class="onboarding-steps">
        <view class="onboarding-item">
          <view class="onboarding-num">1</view>
          <view class="onboarding-text">填写企业基本信息</view>
        </view>
        <view class="onboarding-item">
          <view class="onboarding-num">2</view>
          <view class="onboarding-text">AI生成诊断报告</view>
        </view>
        <view class="onboarding-item">
          <view class="onboarding-num">3</view>
          <view class="onboarding-text">7天执行清单 + 周末复盘</view>
        </view>
      </view>

      <view class="action-area">
        <button class="btn-primary" bindtap="goProfile">立即开始</button>
      </view>
    </block>
  </block>
</view>
