<view class="dashboard-page">
  <view class="progress-section">
    <progress-bar
      currentWeek="{{currentWeek}}"
      totalWeeks="{{totalWeeks}}"
      phaseIndex="{{phaseInfo.phase_index}}"
      phaseName="{{phaseInfo.phase_name}}"
    />
  </view>

  <view class="DashboardSection">
    <view class="SectionTitle">
      <view class="title-left">
        <text class="title-icon">🎯</text>
        <text class="title-text">今日聚焦</text>
      </view>
      <view class="title-right" bindtap="onGoWeekly">
        <text class="more-text">全部任务</text>
        <text class="more-arrow">›</text>
      </view>
    </view>

    <view class="TodayArea">
      <block wx:if="{{todayTasks.length > 0}}">
        <task-card
          wx:for="{{todayTasks}}"
          wx:key="id"
          task="{{item}}"
          showCheckin="{{true}}"
          bind:detail="onTaskDetail"
          bind:checkin="onCheckIn"
        />
      </block>
      <view wx:else class="empty-wrap">
        <empty-state
          icon="🌞"
          text="今日暂无任务，好好休息～"
          actionText="去看本周任务"
          bind:action="onGoWeekly"
        />
      </view>
    </view>
  </view>

  <view class="DashboardSection">
    <view class="SectionTitle">
      <view class="title-left">
        <text class="title-icon">📊</text>
        <text class="title-text">本周完成率</text>
      </view>
    </view>

    <view class="CompletionBar">
      <view class="chart-area">
        <view class="bars-row">
          <view
            class="bar-col"
            wx:for="{{weekCompletion}}"
            wx:key="day"
          >
            <view class="bar-outer">
              <view
                class="bar-inner {{item.isCompleted ? 'bar-done' : ''}} {{item.isToday ? 'bar-today' : ''}}"
                style="height: {{item.barHeight}}%"
              >
                <view wx:if="{{item.rate > 15}}" class="bar-rate">{{item.rate}}%</view>
              </view>
            </view>
            <text class="bar-label {{item.isToday ? 'today-label' : ''}}">{{item.day}}</text>
          </view>
        </view>
      </view>
      <view class="legend-row">
        <view class="legend-item">
          <view class="legend-dot done-dot"></view>
          <text class="legend-text">已完成</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot today-dot"></view>
          <text class="legend-text">今天</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot pending-dot"></view>
          <text class="legend-text">待完成</text>
        </view>
      </view>
    </view>
  </view>

  <view class="DashboardSection">
    <view class="SectionTitle">
      <view class="title-left">
        <text class="title-icon">⚡</text>
        <text class="title-text">快捷入口</text>
      </view>
    </view>

    <view class="ShortcutGrid">
      <view class="shortcut-card" bindtap="onGoRoadmap">
        <view class="sc-icon-wrap roadmap-bg">
          <text class="sc-icon">🗺️</text>
        </view>
        <text class="sc-text">路线图</text>
      </view>
      <view class="shortcut-card" bindtap="onGoDiagnosis">
        <view class="sc-icon-wrap diagnosis-bg">
          <text class="sc-icon">🔍</text>
        </view>
        <text class="sc-text">诊断</text>
      </view>
      <view class="shortcut-card" bindtap="onGoWeekly">
        <view class="sc-icon-wrap weekly-bg">
          <text class="sc-icon">📅</text>
        </view>
        <text class="sc-text">本周任务</text>
      </view>
      <view class="shortcut-card" bindtap="onGoReview">
        <view class="sc-icon-wrap review-bg">
          <text class="sc-icon">📝</text>
        </view>
        <text class="sc-text">复盘</text>
      </view>
      <view class="shortcut-card" bindtap="onGoProfile">
        <view class="sc-icon-wrap profile-bg">
          <text class="sc-icon">👤</text>
        </view>
        <text class="sc-text">我的</text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
