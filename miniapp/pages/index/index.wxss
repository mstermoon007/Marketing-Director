.dashboard-page {
  min-height: 100vh;
  background: var(--color-background);
}

.progress-section {
  background: #fff;
  padding: 24rpx 0 8rpx;
}

.DashboardSection {
  margin: 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.SectionTitle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-icon {
  font-size: 32rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.title-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.more-arrow {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transform: rotate(0deg);
}

.TodayArea {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-wrap {
  padding: 40rpx 0 20rpx;
}

.CompletionBar {
  padding: 8rpx 0 16rpx;
}

.chart-area {
  width: 100%;
  padding: 24rpx 8rpx 0;
}

.bars-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding: 0 16rpx;
  gap: 12rpx;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar-outer {
  width: 44rpx;
  height: 200rpx;
  background: var(--color-background);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  position: relative;
}

.bar-inner {
  width: 100%;
  background: #d6d8dc;
  border-radius: var(--radius-sm);
  transition: height 0.5s ease;
  min-height: 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
}

.bar-inner.bar-done {
  background: var(--color-success);
}

.bar-inner.bar-today {
  border: 4rpx solid var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(25, 137, 250, 0.15);
}

.bar-inner.bar-done.bar-today {
  background: var(--color-success);
}

.bar-rate {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

.bar-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.bar-label.today-label {
  color: var(--color-primary);
  font-weight: 700;
}

.legend-row {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border-light);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.done-dot {
  background: var(--color-success);
}

.today-dot {
  background: #fff;
  border: 4rpx solid var(--color-primary);
  width: 16rpx;
  height: 16rpx;
}

.pending-dot {
  background: #d6d8dc;
}

.legend-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.ShortcutGrid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32rpx 16rpx;
  padding: 8rpx 8rpx 4rpx;
}

.shortcut-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.sc-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.roadmap-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.diagnosis-bg {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.weekly-bg {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.review-bg {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.profile-bg {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.sc-icon {
  font-size: 42rpx;
}

.sc-text {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
}

.bottom-space {
  height: 48rpx;
}
